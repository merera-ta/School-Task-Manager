PORT=5000
NODE_ENV=development

# Local MongoDB (default). For Atlas, paste your connection string instead:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/school_task_manager?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/school_task_manager

# Frontend origin(s) allowed by CORS (comma-separated)
CLIENT_ORIGIN=http://localhost:5173
